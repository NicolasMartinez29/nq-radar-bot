//@version=6
indicator("NQ RADAR FEED V1 — FROM ZERO", overlay=true)

// ============================================================
// NQ RADAR FEED V1
// Sends one CLOSED 1-minute candle to Cloudflare via alert()
// PAPER SYSTEM FEED ONLY
// ============================================================

feedSecret = input.string("", "NQ_FEED_SECRET")
sendSession = input.session("0925-1605", "Feed session (New York)")
feedTimezone = "America/New_York"

isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
inFeedSession = not na(time(timeframe.period, sendSession, feedTimezone))

string jsonMessage =
     "{"
   + "\"secret\":\"" + feedSecret + "\","
   + "\"symbol\":\"" + syminfo.tickerid + "\","
   + "\"timeframe\":\"" + timeframe.period + "\","
   + "\"time\":" + str.tostring(time) + ","
   + "\"open\":" + str.tostring(open) + ","
   + "\"high\":" + str.tostring(high) + ","
   + "\"low\":" + str.tostring(low) + ","
   + "\"close\":" + str.tostring(close) + ","
   + "\"volume\":" + str.tostring(volume)
   + "}"

if barstate.isconfirmed and isOneMinute and inFeedSession and str.length(feedSecret) >= 12
    alert(jsonMessage, alert.freq_once_per_bar_close)

// Visual helpers only.
newYorkHour = hour(time, feedTimezone)
newYorkMinute = minute(time, feedTimezone)
minuteOfDay = newYorkHour * 60 + newYorkMinute

orbActive = minuteOfDay >= 570 and minuteOfDay < 585

bgcolor(orbActive ? color.new(color.orange, 88) : na, title="09:30–09:45 ET ORB")

plotchar(
     not isOneMinute,
     title="WRONG TIMEFRAME",
     char="⚠",
     location=location.top,
     color=color.red,
     size=size.small
)
