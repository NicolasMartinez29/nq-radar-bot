//@version=6
indicator("NQ RADAR V3 PREDATOR FEED — NO SECRET", overlay=true)

sendSession = input.session("0800-1605", "Feed session (New York)")
tz = "America/New_York"

is1m = timeframe.isminutes and timeframe.multiplier == 1
inSession = not na(time(timeframe.period, sendSession, tz))

string payload =
     "{"
   + "\"symbol\":\"" + syminfo.tickerid + "\","
   + "\"timeframe\":\"" + timeframe.period + "\","
   + "\"time\":" + str.tostring(time) + ","
   + "\"open\":" + str.tostring(open) + ","
   + "\"high\":" + str.tostring(high) + ","
   + "\"low\":" + str.tostring(low) + ","
   + "\"close\":" + str.tostring(close) + ","
   + "\"volume\":" + str.tostring(volume)
   + "}"

if barstate.isconfirmed and is1m and inSession
    alert(payload, alert.freq_once_per_bar_close)

nyHour = hour(time, tz)
nyMinute = minute(time, tz)
m = nyHour * 60 + nyMinute

orb = m >= 570 and m < 585
pre = m >= 480 and m < 570

bgcolor(
     orb ? color.new(color.orange, 86) :
     pre ? color.new(color.blue, 94) :
     na
)

plotchar(
     not is1m,
     title="WRONG TIMEFRAME",
     char="⚠",
     location=location.top,
     color=color.red,
     size=size.small
)
